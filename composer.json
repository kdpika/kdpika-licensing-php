{
  "name": "kdpika/license-sdk",
  "description": "Official KDPika Licensing SDK for PHP",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "paragonie/sodium_compat": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "KDPika\\LicenseSdk\\": "src/"
    }
  },
  "homepage": "https://licensing.kdpika.com/docs/v1/sdks/php",
  "archive": {
